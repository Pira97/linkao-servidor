[COMBATE]
; ====== Reglas globales de combate (editables en caliente con /reloadbalance) ======
; Si borras una linea, vuelve al valor por defecto (el mismo que tenia el codigo).
; Los porcentajes van como numero entero: 25 = 25%, 150 = 150%.

; Cuanto absorbe la armadura en PvP (PvE siempre absorbe 100%). Default 25.
; Subilo (ej 40) para que el PvP sea mas lento y la armadura valga mas.
ArmaduraDefiendePvP=25

; Piso de dano en PvP: ningun golpe que conecta pega menos que esto. Default 5.
DanoMinimoPvP=5

; Techo de dano PvP = dano base del arma * (este % / 100). Default 150 (=1.5x).
TopeBurstPvP=150

; Curva de probabilidad de acertar: prob = ImpactoBase + (ataque - evasion), recortada a [Min, Max].
ImpactoBase=80
ImpactoMin=40
ImpactoMax=98

; Cuanto pesa el nivel en ataque y evasion. PesoNivel va x10: 25 = 2.5 por nivel. Default 25.
; NivelBase = a partir de que nivel empieza a sumar. Default 12.
PesoNivel=25
NivelBase=12

; Escala del dano magico con el nivel del lanzador (x nivel). Default: 2 en PvP, 3 en PvE.
EscalaMagiaPvP=2
EscalaMagiaPvE=3

; Bonus de dano (%) si Fuerza Y Agilidad estan al maximo. Default 7.
BonusStatsMax=7

; Escala del dano magico con la Inteligencia del lanzador (% por punto de INT). Default 100 (=1%/INT).
; Se puede sobreescribir por hechizo con EscalaINT en Hechizos.dat (0 = usar este default).
EscalaMagiaINT=100

; Piso/techo de dano magico configurable (0 = sin piso/techo, compatibilidad historica).
; Se pueden sobreescribir por hechizo con DanoMagicoMin/DanoMagicoMax en Hechizos.dat.
DanoMagicoMinPvP=0
DanoMagicoMaxPvP=0
DanoMagicoMinPvE=0
DanoMagicoMaxPvE=0

[RESPAWN]
; ====== Tiempo que tardan los NPCs en revivir (editable en caliente con /reloadbalance) ======
; Antes era una constante de 20s para TODOS: la hormiga y el Rey Dragon reaparecian igual de
; rapido. Ahora el tiempo escala con la exp que da el bicho (su dificultad):
;
;   segundos = Segundos * (GiveEXP / ExpReferencia) ^ (Escala/100)   , recortado a SegundosMax
;
; Con los valores de abajo:
;   Hormiga (6 exp) 45s . Lobo (295) 45s . bicho medio (3.200) ~103s . fuerte (32.000) ~231s
;   . Guardian (550.000) y jefes (Rey Dragon, Dragon Legendario) 600s = 10 min.
; Los NPCs sin exp (guardias, mercaderes, aldeanos) usan el piso: Segundos.
; OJO: se usa el GiveEXP CRUDO de NPCs.dat, sin el multiplicador Exp de Server.ini.

; Piso: lo que tarda el bicho mas debil. Subilo para frenar el farmeo en general.
Segundos=45

; Techo: lo maximo que puede tardar un jefe. Default 600 (10 min).
SegundosMax=600

; Exp a partir de la cual el tiempo empieza a crecer por encima del piso. Default 300.
ExpReferencia=300

; Cuanto pesa la exp, x100: 35 = exponente 0.35. Mas alto = los jefes tardan MUCHO mas que
; los bichos comunes; 0 = todos tardan lo mismo (Segundos).
Escala=35

; Variacion aleatoria +- en %. Evita que un grupo de bichos muerto junto reaparezca todo
; sincronizado de golpe. Default 20 (un bicho de 45s revive entre 36s y 54s). 0 = sin jitter.
Jitter=20

; Para pisar el tiempo de UN npc puntual, poner "RespawnSegundos=N" en su bloque de NPCs.dat
; (no confundir con el "RespawnTime=1" heredado del AO original, que es un flag, no segundos).

[INTERVALOS]
; ====== Cooldowns de golpe y hechizo (editables en caliente con /reloadbalance o desde
; el panel GM, pestana Intervalos). Si borras una linea, vuelve al valor por defecto.
; Valores en MILISEGUNDOS.

; Cooldown entre golpes de un arma (IntervaloUserPuedeAtacar). Default 1200.
Atacar=1200

; Cooldown entre lanzamientos de hechizo (IntervaloLanzaHechizo). Default 500.
LanzarSpell=1150




















[EXP]
TasaGlobalOro=10


TasaGlobal=10
